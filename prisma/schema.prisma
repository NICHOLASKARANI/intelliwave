generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// CORE USER & AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  avatar        String?
  role          String    @default("USER")
  isActive      Boolean   @default(true)
  phoneVerified Boolean   @default(false)
  otpCode       String?
  otpExpiry     DateTime?
  resetToken    String?
  resetExpiry   DateTime?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  invoices       Invoice[]
  supportTickets SupportTicket[]
  blogPosts      BlogPost[]
  comments       Comment[]
  applications   JobApplication[]
  events         Event[]
  messages       Message[]
  organizations  Organization[]
  subscription   Subscription?
  auditLogs      AuditLog[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUBSCRIPTION & ORGANIZATION
// ============================================================

model Subscription {
  id            String             @id @default(cuid())
  plan          PlanType           @default(TRIAL)
  status        SubscriptionStatus @default(ACTIVE)
  amount        Float              @default(500)
  currency      String             @default("KES")
  startDate     DateTime           @default(now())
  endDate       DateTime?
  trialEndsAt   DateTime?
  nextBillingAt DateTime?
  cancelledAt   DateTime?
  mpesaReceipt  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id])
  organizationId String?        @unique
  organization   Organization?  @relation(fields: [organizationId], references: [id])
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  logo          String?
  currency      String    @default("KES")
  timezone      String    @default("Africa/Nairobi")
  isActive      Boolean   @default(true)
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownerId       String
  owner         User           @relation(fields: [ownerId], references: [id])
  members       User[]
  subscription  Subscription?
  
  chartOfAccounts ChartOfAccount[]
  fiscalYears     FiscalYear[]
  journalEntries  JournalEntry[]
}

enum PlanType {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ============================================================
// PROJECTS & INVOICES
// ============================================================

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("PENDING")
  budget      Float?
  currency    String   @default("KES")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  clientId    String
  client      User      @relation(fields: [clientId], references: [id])
  
  invoices    Invoice[]
  milestones  Milestone[]
  messages    Message[]
  files       ProjectFile[]
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  amount      Float
  currency    String   @default("KES")
  status      String   @default("PENDING")
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// BLOG & COMMENTS
// ============================================================

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String   @db.Text
  excerpt       String?
  featuredImage String?
  category      String
  tags          String[]
  published     Boolean  @default(false)
  metaTitle     String?
  metaDesc      String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUPPORT & MESSAGES
// ============================================================

model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  description String   @db.Text
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  sender    String
  createdAt DateTime @default(now())
  
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
}

// ============================================================
// PORTFOLIO, JOBS, EVENTS, LEADS
// ============================================================

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  category     String
  technologies String[]
  thumbnail    String?
  images       String[]
  results      Json?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  description  String   @db.Text
  requirements String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  resume      String
  coverLetter String?  @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  type            String
  location        String?
  virtual         Boolean  @default(false)
  startDate       DateTime
  endDate         DateTime
  image           String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  
  attendees       User[]
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  source    String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

// ============================================================
// WAVECORE ERP - FINANCE MODULE
// ============================================================

model ChartOfAccount {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  parent      ChartOfAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("AccountHierarchy")
  isActive    Boolean     @default(true)
  isReconcilable Boolean  @default(false)
  description String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  journalItems  JournalItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model FiscalYear {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  periods     FiscalPeriod[]
  createdAt   DateTime @default(now())
}

model FiscalPeriod {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  
  journalEntries JournalEntry[]
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String      @id @default(cuid())
  number      String      @unique
  date        DateTime
  reference   String?
  description String
  status      EntryStatus @default(DRAFT)
  amount      Float       @default(0)
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  items       JournalItem[]
  auditLogs   AuditLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

model JournalItem {
  id          String   @id @default(cuid())
  description String?
  debit       Float    @default(0)
  credit      Float    @default(0)
  accountId   String
  account     ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  changes     String?
  userId      String?
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  
  createdAt   DateTime @default(now())
}