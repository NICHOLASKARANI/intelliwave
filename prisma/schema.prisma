generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// USER & AUTHENTICATION
// ============================================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  phone         String?
  avatar        String?
  role          String    @default("USER")
  isActive      Boolean   @default(true)
  phoneVerified Boolean   @default(false)
  otpCode       String?
  otpExpiry     DateTime?
  resetToken    String?
  resetExpiry   DateTime?
  lastLogin     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  accounts       Account[]
  sessions       Session[]
  projects       Project[]
  invoices       Invoice[]
  supportTickets SupportTicket[]
  blogPosts      BlogPost[]
  comments       Comment[]
  applications   JobApplication[]
  events         Event[]
  messages       Message[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberOrganizations Organization[] @relation("OrganizationMembers")
  subscription   Subscription?
  auditLogs      AuditLog[]
}

// ============================================================
// AUTH MODELS
// ============================================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUBSCRIPTION & ORGANIZATION
// ============================================================

model Subscription {
  id            String             @id @default(cuid())
  plan          PlanType           @default(TRIAL)
  status        SubscriptionStatus @default(ACTIVE)
  amount        Float              @default(500)
  currency      String             @default("KES")
  startDate     DateTime           @default(now())
  endDate       DateTime?
  trialEndsAt   DateTime?
  nextBillingAt DateTime?
  cancelledAt   DateTime?
  mpesaReceipt  String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id])
  organizationId String?        @unique
  organization   Organization?  @relation(fields: [organizationId], references: [id])
}

model Organization {
  id            String    @id @default(cuid())
  name          String
  email         String?
  phone         String?
  address       String?
  logo          String?
  currency      String    @default("KES")
  timezone      String    @default("Africa/Nairobi")
  isActive      Boolean   @default(true)
  trialEndsAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  ownerId       String
  owner         User           @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members       User[]         @relation("OrganizationMembers")
  subscription  Subscription?
  
  chartOfAccounts ChartOfAccount[]
  fiscalYears     FiscalYear[]
  journalEntries  JournalEntry[]
}

enum PlanType {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

// ============================================================
// PROJECTS & INVOICES
// ============================================================

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("PENDING")
  budget      Float?
  currency    String   @default("KES")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  clientId    String
  client      User      @relation(fields: [clientId], references: [id])
  
  invoices    Invoice[]
  milestones  Milestone[]
  messages    Message[]
  files       ProjectFile[]
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String   @id @default(cuid())
  number      String   @unique
  amount      Float
  currency    String   @default("KES")
  status      String   @default("PENDING")
  dueDate     DateTime
  paidAt      DateTime?
  createdAt   DateTime @default(now())
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  projectId   String?
  project     Project? @relation(fields: [projectId], references: [id])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

// ============================================================
// BLOG & COMMENTS
// ============================================================

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String   @db.Text
  excerpt       String?
  featuredImage String?
  category      String
  tags          String[]
  published     Boolean  @default(false)
  metaTitle     String?
  metaDesc      String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================================
// SUPPORT & MESSAGES
// ============================================================

model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  description String   @db.Text
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  sender    String
  createdAt DateTime @default(now())
  
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
}

// ============================================================
// PORTFOLIO, JOBS, EVENTS, LEADS
// ============================================================

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  category     String
  technologies String[]
  thumbnail    String?
  images       String[]
  results      Json?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  description  String   @db.Text
  requirements String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  resume      String
  coverLetter String?  @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  type            String
  location        String?
  virtual         Boolean  @default(false)
  startDate       DateTime
  endDate         DateTime
  image           String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  
  attendees       User[]
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  email     String
  company   String?
  phone     String?
  source    String?
  message   String?
  status    String   @default("NEW")
  createdAt DateTime @default(now())
}

// ============================================================
// WAVECORE ERP - FINANCE MODULE
// ============================================================

model ChartOfAccount {
  id          String      @id @default(cuid())
  code        String      @unique
  name        String
  type        AccountType
  parentId    String?
  parent      ChartOfAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children    ChartOfAccount[] @relation("AccountHierarchy")
  isActive    Boolean     @default(true)
  isReconcilable Boolean  @default(false)
  description String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  journalItems  JournalItem[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model FiscalYear {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  periods     FiscalPeriod[]
  createdAt   DateTime @default(now())
}

model FiscalPeriod {
  id          String   @id @default(cuid())
  name        String
  startDate   DateTime
  endDate     DateTime
  isClosed    Boolean  @default(false)
  fiscalYearId String
  fiscalYear   FiscalYear @relation(fields: [fiscalYearId], references: [id])
  
  journalEntries JournalEntry[]
  createdAt   DateTime @default(now())
}

model JournalEntry {
  id          String      @id @default(cuid())
  number      String      @unique
  date        DateTime
  reference   String?
  description String
  status      EntryStatus @default(DRAFT)
  amount      Float       @default(0)
  fiscalPeriodId String
  fiscalPeriod   FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  items       JournalItem[]
  auditLogs   AuditLog[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

model JournalItem {
  id          String   @id @default(cuid())
  description String?
  debit       Float    @default(0)
  credit      Float    @default(0)
  accountId   String
  account     ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id])
  
  createdAt   DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String
  entityType  String
  entityId    String
  changes     String?
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  journalEntryId String?
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  
  createdAt   DateTime @default(now())
}
// ============================================================
// WAVECORE ERP - CRM & SALES MODULE
// ============================================================

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  address     String?
  city        String?
  country     String?
  taxId       String?
  website     String?
  notes       String?
  type        CustomerType @default(INDIVIDUAL)
  status      CustomerStatus @default(ACTIVE)
  source      String?
  assignedToId String?
  assignedTo   User?    @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  contacts    Contact[]
  leads       Lead[]
  opportunities Opportunity[]
  quotations  Quotation[]
  salesOrders SalesOrder[]
  invoices    CustomerInvoice[]
  payments    CustomerPayment[]
  activities  Activity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
  NGO
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

model Contact {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  email       String?
  phone       String?
  position    String?
  department  String?
  isPrimary   Boolean  @default(false)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Lead {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      LeadStatus @default(NEW)
  priority    Priority @default(MEDIUM)
  notes       String?
  score       Int      @default(0)
  assignedToId String?
  assignedTo   User?    @relation("AssignedLeads", fields: [assignedToId], references: [id])
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  activities  Activity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Opportunity {
  id          String   @id @default(cuid())
  name        String
  amount      Float    @default(0)
  stage       Stage    @default(QUALIFICATION)
  probability Int      @default(0)
  expectedCloseDate DateTime?
  notes       String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  activities  Activity[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum Stage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Quotation {
  id          String   @id @default(cuid())
  number      String   @unique
  date        DateTime @default(now())
  validUntil  DateTime?
  status      QuotationStatus @default(DRAFT)
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  notes       String?
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  items       QuotationItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model QuotationItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model SalesOrder {
  id          String   @id @default(cuid())
  number      String   @unique
  date        DateTime @default(now())
  status      OrderStatus @default(PENDING)
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  items       SalesOrderItem[]
  invoices    CustomerInvoice[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model SalesOrderItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  
  createdAt   DateTime @default(now())
}

model CustomerInvoice {
  id          String   @id @default(cuid())
  number      String   @unique
  date        DateTime @default(now())
  dueDate     DateTime
  status      InvoiceStatus @default(DRAFT)
  subtotal    Float    @default(0)
  taxAmount   Float    @default(0)
  total       Float    @default(0)
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  payments    CustomerPayment[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model CustomerPayment {
  id          String   @id @default(cuid())
  number      String   @unique
  date        DateTime @default(now())
  amount      Float
  method      PaymentMethod @default(MPESA)
  reference   String?
  invoiceId   String
  invoice     CustomerInvoice @relation(fields: [invoiceId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  createdAt   DateTime @default(now())
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
}

model Activity {
  id          String   @id @default(cuid())
  type        ActivityType
  subject     String
  description String?
  dueDate     DateTime?
  completed   Boolean  @default(false)
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id])
  leadId      String?
  lead        Lead?     @relation(fields: [leadId], references: [id])
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId String?
  assignedTo   User?    @relation("AssignedActivities", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
  WHATSAPP
}