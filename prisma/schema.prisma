generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  name                  String?
  email                 String              @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  phone                 String?
  avatar                String?
  role                  String              @default("USER")
  isActive              Boolean             @default(true)
  phoneVerified         Boolean             @default(false)
  otpCode               String?
  otpExpiry             DateTime?
  resetToken            String?
  resetExpiry           DateTime?
  lastLogin             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  accounts              Account[]
  assignedActivities    Activity[]          @relation("AssignedActivities")
  auditLogs             AuditLog[]
  blogPosts             BlogPost[]
  comments              Comment[]
  assignedCustomers     Customer[]          @relation("AssignedCustomers")
  invoices              Invoice[]
  applications          JobApplication[]
  assignedLeads         Lead[]              @relation("AssignedLeads")
  approvedLeaves        LeaveRequest[]      @relation("ApprovedLeaves")
  messages              Message[]
  assignedOpportunities Opportunity[]       @relation("AssignedOpportunities")
  ownedOrganizations    Organization[]      @relation("OrganizationOwner")
  reviewerReviews       PerformanceReview[] @relation("ReviewerReviews")
  projects              Project[]
  sessions              Session[]
  subscription          Subscription?
  supportTickets        SupportTicket[]
  events                Event[]             @relation("EventToUser")
  memberOrganizations   Organization[]      @relation("OrganizationMembers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken], map: "idx_session_token")
}

model Subscription {
  id             String             @id @default(cuid())
  plan           PlanType           @default(TRIAL)
  status         SubscriptionStatus @default(ACTIVE)
  amount         Float              @default(500)
  currency       String             @default("KES")
  startDate      DateTime           @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  nextBillingAt  DateTime?
  cancelledAt    DateTime?
  mpesaReceipt   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String?            @unique
  organizationId String?            @unique
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  address              String?
  logo                 String?
  currency             String                @default("KES")
  timezone             String                @default("Africa/Nairobi")
  isActive             Boolean               @default(true)
  trialEndsAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ownerId              String
  activities           Activity[]
  attendances          Attendance[]
  batches              Batch[]
  chartOfAccounts      ChartOfAccount[]
  customers            Customer[]
  customerInvoices     CustomerInvoice[]
  customerPayments     CustomerPayment[]
  employees            Employee[]
  employeeDocuments    EmployeeDocument[]
  fiscalYears          FiscalYear[]
  journalEntries       JournalEntry[]
  leads                Lead[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  leaveTypes           LeaveType[]
  opportunities        Opportunity[]
  owner                User                  @relation("OrganizationOwner", fields: [ownerId], references: [id])
  payrollItems         PayrollItem[]
  payrollPeriods       PayrollPeriod[]
  performanceReviews   PerformanceReview[]
  products             Product[]
  quotations           Quotation[]
  routings             Routing[]
  salesOrders          SalesOrder[]
  serialNumbers        SerialNumber[]
  stockMoves           StockMove[]
  subscription         Subscription?
  trainings            Training[]
  trainingEnrollments  TrainingEnrollment[]
  warehouses           Warehouse[]
  members              User[]                @relation("OrganizationMembers")
  organizationSettings OrganizationSetting[]
  taxRates             TaxRate[]
  documentNumberings   DocumentNumbering[]
  emailTemplates       EmailTemplate[]
  integrations         Integration[]
  currencies           Currency[]
  roles                Role[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  status      String        @default("PENDING")
  budget      Float?
  currency    String        @default("KES")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  clientId    String
  invoices    Invoice[]
  messages    Message[]
  milestones  Milestone[]
  client      User          @relation(fields: [clientId], references: [id])
  files       ProjectFile[]
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  amount    Float
  currency  String    @default("KES")
  status    String    @default("PENDING")
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  featuredImage String?
  category      String
  tags          String[]
  published     Boolean   @default(false)
  metaTitle     String?
  metaDesc      String?
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String    @id @default(cuid())
  subject     String
  description String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  messages    Message[]
  user        User      @relation(fields: [userId], references: [id])
}

model Message {
  id        String         @id @default(cuid())
  content   String
  sender    String
  createdAt DateTime       @default(now())
  ticketId  String?
  projectId String?
  userId    String?
  project   Project?       @relation(fields: [projectId], references: [id])
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String
  technologies String[]
  thumbnail    String?
  images       String[]
  results      Json?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Job {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String[]
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  resume      String
  coverLetter String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  jobId       String
  userId      String
  job         Job      @relation(fields: [jobId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  location        String?
  virtual         Boolean  @default(false)
  startDate       DateTime
  endDate         DateTime
  image           String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  attendees       User[]   @relation("EventToUser")
}

model ChartOfAccount {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  type           AccountType
  parentId       String?
  isActive       Boolean          @default(true)
  isReconcilable Boolean          @default(false)
  description    String?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  parent         ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       ChartOfAccount[] @relation("AccountHierarchy")
  journalItems   JournalItem[]
}

model FiscalYear {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean        @default(false)
  organizationId String
  createdAt      DateTime       @default(now())
  periods        FiscalPeriod[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model FiscalPeriod {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean        @default(false)
  fiscalYearId   String
  createdAt      DateTime       @default(now())
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]
}

model JournalEntry {
  id             String        @id @default(cuid())
  number         String        @unique
  date           DateTime
  reference      String?
  description    String
  status         EntryStatus   @default(DRAFT)
  amount         Float         @default(0)
  fiscalPeriodId String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  items          JournalItem[]

  @@index([organizationId, createdAt], map: "idx_journal_org")
}

model JournalItem {
  id             String         @id @default(cuid())
  description    String?
  debit          Float          @default(0)
  credit         Float          @default(0)
  accountId      String
  journalEntryId String
  createdAt      DateTime       @default(now())
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
}

model AuditLog {
  id             String        @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  changes        String?
  userId         String?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "idx_auditlog_org")
}

model Customer {
  id             String            @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  website        String?
  notes          String?
  type           CustomerType      @default(INDIVIDUAL)
  status         CustomerStatus    @default(ACTIVE)
  source         String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  activities     Activity[]
  contacts       Contact[]
  assignedTo     User?             @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  invoices       CustomerInvoice[]
  payments       CustomerPayment[]
  leads          Lead[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@index([organizationId], map: "idx_customer_org")
}

model Contact {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  department String?
  isPrimary  Boolean  @default(false)
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  priority       Priority     @default(MEDIUM)
  notes          String?
  score          Int          @default(0)
  assignedToId   String?
  customerId     String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  assignedTo     User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "idx_lead_org")
}

model Opportunity {
  id                String       @id @default(cuid())
  name              String
  amount            Float        @default(0)
  stage             Stage        @default(QUALIFICATION)
  probability       Int          @default(0)
  expectedCloseDate DateTime?
  notes             String?
  customerId        String
  assignedToId      String?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activities        Activity[]
  assignedTo        User?        @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  customer          Customer     @relation(fields: [customerId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "idx_opportunity_org")
}

model Quotation {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  validUntil     DateTime?
  status         QuotationStatus @default(DRAFT)
  subtotal       Float           @default(0)
  taxAmount      Float           @default(0)
  total          Float           @default(0)
  notes          String?
  customerId     String
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       Customer        @relation(fields: [customerId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          QuotationItem[]
  salesOrders    SalesOrder[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  total       Float     @default(0)
  quotationId String
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id             String            @id @default(cuid())
  number         String            @unique
  date           DateTime          @default(now())
  status         OrderStatus       @default(PENDING)
  subtotal       Float             @default(0)
  taxAmount      Float             @default(0)
  total          Float             @default(0)
  customerId     String
  quotationId    String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  invoices       CustomerInvoice[]
  customer       Customer          @relation(fields: [customerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  quotation      Quotation?        @relation(fields: [quotationId], references: [id])
  items          SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  description  String
  quantity     Int        @default(1)
  unitPrice    Float      @default(0)
  total        Float      @default(0)
  salesOrderId String
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model CustomerInvoice {
  id             String            @id @default(cuid())
  number         String            @unique
  date           DateTime          @default(now())
  dueDate        DateTime
  status         InvoiceStatus     @default(DRAFT)
  subtotal       Float             @default(0)
  taxAmount      Float             @default(0)
  total          Float             @default(0)
  customerId     String
  salesOrderId   String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       Customer          @relation(fields: [customerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  payments       CustomerPayment[]

  @@index([organizationId, createdAt], map: "idx_invoice_org")
}

model CustomerPayment {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  amount         Float
  method         PaymentMethod   @default(MPESA)
  reference      String?
  invoiceId      String
  customerId     String
  organizationId String
  createdAt      DateTime        @default(now())
  customer       Customer        @relation(fields: [customerId], references: [id])
  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  subject        String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  customerId     String?
  leadId         String?
  opportunityId  String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedTo     User?        @relation("AssignedActivities", fields: [assignedToId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  city           String?
  country        String?
  isActive       Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  locations      StockLocation[]
  stockMoves     StockMove[]
  organization   Organization    @relation(fields: [organizationId], references: [id])
}

model StockLocation {
  id              String          @id @default(cuid())
  name            String
  code            String
  warehouseId     String
  parentId        String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parent          StockLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children        StockLocation[] @relation("LocationHierarchy")
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  fromMoves       StockMove[]     @relation("FromLocation")
  toMoves         StockMove[]     @relation("ToLocation")
  stockQuantities StockQuantity[]
}

model Product {
  id                String          @id @default(cuid())
  name              String
  sku               String          @unique
  barcode           String?
  description       String?
  category          String?
  unit              String          @default("Unit")
  costPrice         Float           @default(0)
  sellingPrice      Float           @default(0)
  minStock          Float           @default(0)
  maxStock          Float           @default(0)
  isActive          Boolean         @default(true)
  isTracked         Boolean         @default(true)
  trackSerial       Boolean         @default(false)
  trackBatch        Boolean         @default(false)
  organizationId    String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  routingOperations BOMComponent[]
  batches           Batch[]
  organization      Organization    @relation(fields: [organizationId], references: [id])
  routings          Routing[]
  serialNumbers     SerialNumber[]
  stockMoves        StockMove[]
  stockQuantities   StockQuantity[]

  @@index([organizationId], map: "idx_product_org")
}

model StockQuantity {
  id           String        @id @default(cuid())
  quantity     Float         @default(0)
  reservedQty  Float         @default(0)
  availableQty Float         @default(0)
  productId    String
  locationId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  location     StockLocation @relation(fields: [locationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
}

model StockMove {
  id             String         @id @default(cuid())
  type           StockMoveType
  reference      String?
  date           DateTime       @default(now())
  status         MoveStatus     @default(DRAFT)
  notes          String?
  productId      String
  quantity       Float          @default(0)
  fromLocationId String?
  toLocationId   String?
  warehouseId    String?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batches        Batch[]
  serialNumbers  SerialNumber[]
  fromLocation   StockLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  toLocation     StockLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  warehouse      Warehouse?     @relation(fields: [warehouseId], references: [id])
}

model SerialNumber {
  id             String       @id @default(cuid())
  number         String       @unique
  productId      String
  status         SerialStatus @default(AVAILABLE)
  stockMoveId    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  stockMove      StockMove?   @relation(fields: [stockMoveId], references: [id])
}

model Batch {
  id                String       @id @default(cuid())
  number            String
  productId         String
  quantity          Float        @default(0)
  expiryDate        DateTime?
  manufacturingDate DateTime?
  stockMoveId       String?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])
  stockMove         StockMove?   @relation(fields: [stockMoveId], references: [id])
}

model BillOfMaterial {
  id             String   @id @default(cuid())
  name           String
  code           String
  productId      String?
  quantity       Float    @default(1)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BOMComponent {
  id        String   @id @default(cuid())
  bomId     String
  productId String
  quantity  Float    @default(1)
  unit      String   @default("Unit")
  scrapRate Float    @default(0)
  operation String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model WorkCenter {
  id             String   @id @default(cuid())
  name           String
  code           String
  description    String?
  capacity       Float    @default(0)
  efficiency     Float    @default(100)
  costPerHour    Float    @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Routing {
  id             String             @id @default(cuid())
  name           String
  code           String             @unique
  productId      String
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  operations     RoutingOperation[]
}

model RoutingOperation {
  id              String   @id @default(cuid())
  sequence        Int
  name            String
  description     String?
  durationMinutes Float    @default(0)
  setupMinutes    Float    @default(0)
  routingId       String
  workCenterId    String
  createdAt       DateTime @default(now())
  routing         Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id             String    @id @default(cuid())
  number         String
  type           String    @default("MANUFACTURING")
  status         String    @default("DRAFT")
  quantity       Float     @default(0)
  completedQty   Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  priority       String    @default("MEDIUM")
  notes          String?
  productId      String?
  bomId          String?
  workCenterId   String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model QualityCheck {
  id             String   @id @default(cuid())
  type           String   @default("FINAL")
  result         String   @default("PENDING")
  notes          String?
  inspectedQty   Float    @default(0)
  passedQty      Float    @default(0)
  rejectedQty    Float    @default(0)
  workOrderId    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MaintenanceRequest {
  id             String    @id @default(cuid())
  number         String
  type           String    @default("CORRECTIVE")
  status         String    @default("REQUESTED")
  description    String
  assetName      String
  assetCode      String?
  priority       String    @default("MEDIUM")
  requestedDate  DateTime  @default(now())
  completedDate  DateTime?
  assignedToId   String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Employee {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  firstName          String
  lastName           String
  email              String?
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  maritalStatus      String?
  nationality        String?
  idNumber           String?
  taxPin             String?
  nssfNumber         String?
  nhifNumber         String?
  address            String?
  city               String?
  country            String?
  emergencyContact   String?
  emergencyPhone     String?
  department         String?
  position           String?
  employmentType     EmploymentType       @default(FULL_TIME)
  status             EmployeeStatus       @default(ACTIVE)
  hireDate           DateTime?
  terminationDate    DateTime?
  salary             Float                @default(0)
  currency           String               @default("KES")
  bankName           String?
  bankAccount        String?
  notes              String?
  organizationId     String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  attendances        Attendance[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  documents          EmployeeDocument[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  payrollItems       PayrollItem[]
  performanceReviews PerformanceReview[]
  trainings          TrainingEnrollment[]

  @@index([organizationId], map: "idx_employee_org")
}

model Attendance {
  id             String           @id @default(cuid())
  date           DateTime         @default(now())
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  employeeId     String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id])
}

model LeaveType {
  id               String         @id @default(cuid())
  name             String
  description      String?
  daysPerYear      Int            @default(21)
  isPaid           Boolean        @default(true)
  requiresApproval Boolean        @default(true)
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  organization     Organization   @relation(fields: [organizationId], references: [id])
}

model LeaveBalance {
  id             String       @id @default(cuid())
  totalDays      Float        @default(0)
  usedDays       Float        @default(0)
  remainingDays  Float        @default(0)
  year           Int
  employeeId     String
  leaveTypeId    String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveStatus  @default(PENDING)
  employeeId     String
  leaveTypeId    String
  approvedById   String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvedBy     User?        @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model PayrollPeriod {
  id             String        @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  paymentDate    DateTime
  status         PayrollStatus @default(DRAFT)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          PayrollItem[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
}

model PayrollItem {
  id              String        @id @default(cuid())
  basicSalary     Float         @default(0)
  allowances      Float         @default(0)
  deductions      Float         @default(0)
  netSalary       Float         @default(0)
  employeeId      String
  payrollPeriodId String
  organizationId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id])
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  reviewDate     DateTime     @default(now())
  rating         Int          @default(0)
  strengths      String?
  improvements   String?
  goals          String?
  employeeId     String
  reviewerId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  reviewer       User         @relation("ReviewerReviews", fields: [reviewerId], references: [id])
}

model Training {
  id             String               @id @default(cuid())
  title          String
  description    String?
  type           String
  startDate      DateTime
  endDate        DateTime
  provider       String?
  cost           Float                @default(0)
  organizationId String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id])
  enrollments    TrainingEnrollment[]
}

model TrainingEnrollment {
  id             String       @id @default(cuid())
  status         String       @default("ENROLLED")
  completionDate DateTime?
  notes          String?
  employeeId     String
  trainingId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  training       Training     @relation(fields: [trainingId], references: [id])
}

model EmployeeDocument {
  id             String       @id @default(cuid())
  name           String
  type           String
  url            String
  employeeId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model UserProfile {
  id        Int       @id @default(autoincrement())
  userid    String    @unique
  fullname  String
  email     String    @unique
  phone     String?
  avatar    String?
  role      String?   @default("User")
  status    String?   @default("Active")
  createdat DateTime? @default(now()) @db.Timestamp(6)
  updatedat DateTime? @default(now()) @db.Timestamp(6)
}

model OrganizationSetting {
  id             Int          @id @default(autoincrement())
  organizationId String
  companyname    String       @default("WaveCore ERP")
  email          String?
  phone          String?
  address        String?
  website        String?
  timezone       String?      @default("Africa/Nairobi")
  language       String?      @default("English")
  currency       String?      @default("KES")
  dateformat     String?      @default("DD/MM/YYYY")
  currencysymbol String?      @default("KSh")
  numberformat   String?      @default("1,234.56")
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model TaxRate {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  rate           Decimal      @db.Decimal(5, 2)
  type           String       @default("VAT")
  active         Boolean?     @default(true)
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model DocumentNumbering {
  id             Int          @id @default(autoincrement())
  organizationId String
  documenttype   String
  prefix         String
  nextnumber     Int?         @default(1)
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documenttype])
  @@index([organizationId])
}

model EmailTemplate {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  subject        String
  body           String?
  active         Boolean?     @default(true)
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Integration {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  type           String
  apikey         String?
  status         String?      @default("Disconnected")
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ApiKey {
  id             String    @id
  organizationId String
  name           String
  key            String    @unique(map: "idx_apikey_key")
  prefix         String
  lastUsedAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([organizationId, isActive], map: "idx_apikey_org")
}

model BankAccount {
  id             String   @id
  name           String
  accountNumber  String
  bankName       String
  currency       String   @default("KES")
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([organizationId, isActive], map: "idx_bankaccount_org")
}

model BankReconciliation {
  id               String    @id
  bankAccountId    String
  statementDate    DateTime
  statementBalance Float
  closingBalance   Float     @default(0)
  status           String    @default("IN_PROGRESS")
  organizationId   String
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([organizationId, status], map: "idx_bankrecon_org")
}

model BankTransaction {
  id                   String   @id
  bankAccountId        String
  date                 DateTime
  description          String
  reference            String?
  amount               Float
  type                 String   @default("CREDIT")
  matched              Boolean  @default(false)
  matchedTransactionId String?
  organizationId       String
  createdAt            DateTime @default(now())

  @@index([organizationId, matched, date], map: "idx_banktxn_org")
}

model Budget {
  id             String    @id
  name           String
  fiscalYear     Int
  period         String    @default("ANNUAL")
  amount         Float?    @default(0)
  organizationId String
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @default(now())
}

model Currency {
  id             Int          @id @default(autoincrement())
  organizationId String
  code           String
  name           String
  rate           Decimal      @db.Decimal(10, 4)
  isdefault      Boolean?     @default(false)
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Notification {
  id             String   @id
  userId         String?
  organizationId String?
  type           String   @default("SYSTEM")
  title          String
  content        String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt], map: "idx_notification_org")
  @@index([userId, isRead, createdAt], map: "idx_notification_user")
}

model PipelineStage {
  id             String   @id
  name           String
  order          Int      @default(0)
  color          String   @default("#6366f1")
  organizationId String
  createdAt      DateTime @default(now())

  @@index([organizationId, order], map: "idx_pipelinestage_org")
}

model PurchaseOrder {
  id             String   @id
  number         String
  date           DateTime @default(now())
  status         String   @default("DRAFT")
  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  total          Float    @default(0)
  supplierName   String
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([organizationId, number], map: "idx_po_number")
  @@index([organizationId, createdAt], map: "idx_po_org")
}

model PurchaseOrderItem {
  id              String   @id
  description     String
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  total           Float    @default(0)
  purchaseOrderId String
  createdAt       DateTime @default(now())
}

model Role {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  description    String?
  permissions    String[]     @default([])
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Webhook {
  id             String   @id
  organizationId String
  name           String
  url            String
  secret         String
  events         String[] @default(dbgenerated("'{*}'::text[]"))
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([organizationId, isActive], map: "idx_webhook_org")
}

