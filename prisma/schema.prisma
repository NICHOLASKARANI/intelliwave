generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  phone            String?
  avatar           String?
  role             String    @default("USER")
  isActive         Boolean   @default(true)
  phoneVerified    Boolean   @default(false)
  otpCode          String?
  otpExpiry        DateTime?
  resetToken       String?
  resetExpiry      DateTime?
  lastLogin        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  accounts         Account[]
  sessions         Session[]
  projects         Project[]
  invoices         Invoice[]
  supportTickets   SupportTicket[]
  blogPosts        BlogPost[]
  comments         Comment[]
  applications     JobApplication[]
  events           Event[]
  messages         Message[]
  ownedOrganizations Organization[] @relation("OrganizationOwner")
  memberOrganizations Organization[] @relation("OrganizationMembers")
  subscription     Subscription?
  auditLogs        AuditLog[]
  assignedCustomers Customer[] @relation("AssignedCustomers")
  assignedLeads     Lead[]     @relation("AssignedLeads")
  assignedOpportunities Opportunity[] @relation("AssignedOpportunities")
  assignedActivities   Activity[]   @relation("AssignedActivities")
  assignedMaintenance  MaintenanceRequest[] @relation("AssignedMaintenance")
  approvedLeaves     LeaveRequest[] @relation("ApprovedLeaves")
  reviewerReviews    PerformanceReview[] @relation("ReviewerReviews")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id             String             @id @default(cuid())
  plan           PlanType           @default(TRIAL)
  status         SubscriptionStatus @default(ACTIVE)
  amount         Float              @default(500)
  currency       String             @default("KES")
  startDate      DateTime           @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  nextBillingAt  DateTime?
  cancelledAt    DateTime?
  mpesaReceipt   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String?            @unique
  user           User?              @relation(fields: [userId], references: [id])
  organizationId String?            @unique
  organization   Organization?      @relation(fields: [organizationId], references: [id])
}

model Organization {
  id               String    @id @default(cuid())
  name             String
  email            String?
  phone            String?
  address          String?
  logo             String?
  currency         String    @default("KES")
  timezone         String    @default("Africa/Nairobi")
  isActive         Boolean   @default(true)
  trialEndsAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  ownerId          String
  owner            User           @relation("OrganizationOwner", fields: [ownerId], references: [id])
  members          User[]         @relation("OrganizationMembers")
  subscription     Subscription?
  chartOfAccounts  ChartOfAccount[]
  fiscalYears      FiscalYear[]
  journalEntries   JournalEntry[]
  customers        Customer[]
  leads            Lead[]
  opportunities    Opportunity[]
  quotations       Quotation[]
  salesOrders      SalesOrder[]
  customerInvoices CustomerInvoice[]
  customerPayments CustomerPayment[]
  activities       Activity[]
  warehouses       Warehouse[]
  products         Product[]
  stockMoves       StockMove[]
  serialNumbers    SerialNumber[]
  batches          Batch[]
  boms             BillOfMaterial[]
  workCenters      WorkCenter[]
  routings         Routing[]
  workOrders       WorkOrder[]
  qualityChecks    QualityCheck[]
  maintenanceRequests MaintenanceRequest[]
  employees        Employee[]
  attendances      Attendance[]
  leaveTypes       LeaveType[]
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  payrollPeriods   PayrollPeriod[]
  payrollItems     PayrollItem[]
  performanceReviews PerformanceReview[]
  trainings        Training[]
  trainingEnrollments TrainingEnrollment[]
  employeeDocuments EmployeeDocument[]
}



enum PlanType {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

model Project {
  id          String   @id @default(cuid())
  title       String
  description String   @db.Text
  status      String   @default("PENDING")
  budget      Float?
  currency    String   @default("KES")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  clientId    String
  client      User      @relation(fields: [clientId], references: [id])
  invoices    Invoice[]
  milestones  Milestone[]
  messages    Message[]
  files       ProjectFile[]
}

model Milestone {
  id          String    @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  projectId   String
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String   @id @default(cuid())
  number    String   @unique
  amount    Float
  currency  String   @default("KES")
  status    String   @default("PENDING")
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  projectId String?
  project   Project? @relation(fields: [projectId], references: [id])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  content       String   @db.Text
  excerpt       String?
  featuredImage String?
  category      String
  tags          String[]
  published     Boolean  @default(false)
  metaTitle     String?
  metaDesc      String?
  views         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  postId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String   @id @default(cuid())
  subject     String
  description String   @db.Text
  priority    String   @default("MEDIUM")
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  messages    Message[]
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  sender    String
  createdAt DateTime @default(now())
  ticketId  String?
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  projectId String?
  project   Project?       @relation(fields: [projectId], references: [id])
  userId    String?
  user      User?          @relation(fields: [userId], references: [id])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String   @db.Text
  category     String
  technologies String[]
  thumbnail    String?
  images       String[]
  results      Json?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Job {
  id           String   @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  description  String   @db.Text
  requirements String[]
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  resume      String
  coverLetter String?  @db.Text
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String   @db.Text
  type            String
  location        String?
  virtual         Boolean  @default(false)
  startDate       DateTime
  endDate         DateTime
  image           String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  attendees       User[]
}

model ChartOfAccount {
  id              String      @id @default(cuid())
  code            String      @unique
  name            String
  type            AccountType
  parentId        String?
  parent          ChartOfAccount? @relation("AccountHierarchy", fields: [parentId], references: [id])
  children        ChartOfAccount[] @relation("AccountHierarchy")
  isActive        Boolean     @default(true)
  isReconcilable  Boolean     @default(false)
  description     String?
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  journalItems    JournalItem[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

model FiscalYear {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean  @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  periods        FiscalPeriod[]
  createdAt      DateTime @default(now())
}

model FiscalPeriod {
  id             String   @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean  @default(false)
  fiscalYearId   String
  fiscalYear     FiscalYear @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]
  createdAt      DateTime @default(now())
}

model JournalEntry {
  id              String      @id @default(cuid())
  number          String      @unique
  date            DateTime
  reference       String?
  description     String
  status          EntryStatus @default(DRAFT)
  amount          Float       @default(0)
  fiscalPeriodId  String
  fiscalPeriod    FiscalPeriod @relation(fields: [fiscalPeriodId], references: [id])
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])
  items           JournalItem[]
  auditLogs       AuditLog[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

model JournalItem {
  id              String   @id @default(cuid())
  description     String?
  debit           Float    @default(0)
  credit          Float    @default(0)
  accountId       String
  account         ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntryId  String
  journalEntry    JournalEntry @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime @default(now())
}

model AuditLog {
  id              String   @id @default(cuid())
  action          String
  entityType      String
  entityId        String
  changes         String?
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  journalEntryId  String?
  journalEntry    JournalEntry? @relation(fields: [journalEntryId], references: [id])
  createdAt       DateTime @default(now())
}

model Customer {
  id             String         @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  website        String?
  notes          String?
  type           CustomerType   @default(INDIVIDUAL)
  status         CustomerStatus @default(ACTIVE)
  source         String?
  assignedToId   String?
  assignedTo     User?          @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id])
  contacts       Contact[]
  leads          Lead[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  invoices       CustomerInvoice[]
  payments       CustomerPayment[]
  activities     Activity[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
  NGO
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

model Contact {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  department String?
  isPrimary  Boolean  @default(false)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Lead {
  id             String     @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus @default(NEW)
  priority       Priority   @default(MEDIUM)
  notes          String?
  score          Int        @default(0)
  assignedToId   String?
  assignedTo     User?      @relation("AssignedLeads", fields: [assignedToId], references: [id])
  customerId     String?
  customer       Customer?  @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  activities     Activity[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Opportunity {
  id               String   @id @default(cuid())
  name             String
  amount           Float    @default(0)
  stage            Stage    @default(QUALIFICATION)
  probability      Int      @default(0)
  expectedCloseDate DateTime?
  notes            String?
  customerId       String
  customer         Customer @relation(fields: [customerId], references: [id])
  assignedToId     String?
  assignedTo       User?    @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  activities       Activity[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

enum Stage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

model Quotation {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  validUntil     DateTime?
  status         QuotationStatus @default(DRAFT)
  subtotal       Float           @default(0)
  taxAmount      Float           @default(0)
  total          Float           @default(0)
  notes          String?
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          QuotationItem[]
  salesOrders    SalesOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

model QuotationItem {
  id          String   @id @default(cuid())
  description String
  quantity    Int      @default(1)
  unitPrice   Float    @default(0)
  total       Float    @default(0)
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

model SalesOrder {
  id             String      @id @default(cuid())
  number         String      @unique
  date           DateTime    @default(now())
  status         OrderStatus @default(PENDING)
  subtotal       Float       @default(0)
  taxAmount      Float       @default(0)
  total          Float       @default(0)
  customerId     String
  customer       Customer    @relation(fields: [customerId], references: [id])
  quotationId    String?
  quotation      Quotation?  @relation(fields: [quotationId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  items          SalesOrderItem[]
  invoices       CustomerInvoice[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

model SalesOrderItem {
  id           String   @id @default(cuid())
  description  String
  quantity     Int      @default(1)
  unitPrice    Float    @default(0)
  total        Float    @default(0)
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model CustomerInvoice {
  id             String        @id @default(cuid())
  number         String        @unique
  date           DateTime      @default(now())
  dueDate        DateTime
  status         InvoiceStatus @default(DRAFT)
  subtotal       Float         @default(0)
  taxAmount      Float         @default(0)
  total          Float         @default(0)
  customerId     String
  customer       Customer      @relation(fields: [customerId], references: [id])
  salesOrderId   String?
  salesOrder     SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  payments       CustomerPayment[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

model CustomerPayment {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  amount         Float
  method         PaymentMethod   @default(MPESA)
  reference      String?
  invoiceId      String
  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id])
  customerId     String
  customer       Customer        @relation(fields: [customerId], references: [id])
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  subject        String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  customerId     String?
  customer       Customer?    @relation(fields: [customerId], references: [id])
  leadId         String?
  lead           Lead?        @relation(fields: [leadId], references: [id])
  opportunityId  String?
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  assignedToId   String?
  assignedTo     User?        @relation("AssignedActivities", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
  WHATSAPP
}

model Warehouse {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  address        String?
  city           String?
  country        String?
  isActive       Boolean   @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  locations      StockLocation[]
  stockMoves     StockMove[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model StockLocation {
  id             String    @id @default(cuid())
  name           String
  code           String
  warehouseId    String
  warehouse      Warehouse @relation(fields: [warehouseId], references: [id])
  parentId       String?
  parent         StockLocation? @relation("LocationHierarchy", fields: [parentId], references: [id])
  children       StockLocation[] @relation("LocationHierarchy")
  isActive       Boolean   @default(true)
  stockQuantities StockQuantity[]
  fromMoves       StockMove[] @relation("FromLocation")
  toMoves         StockMove[] @relation("ToLocation")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Product {
  id             String    @id @default(cuid())
  name           String
  sku            String    @unique
  barcode        String?
  description    String?
  category       String?
  unit           String    @default("Unit")
  costPrice      Float     @default(0)
  sellingPrice   Float     @default(0)
  minStock       Float     @default(0)
  maxStock       Float     @default(0)
  isActive       Boolean   @default(true)
  isTracked      Boolean   @default(true)
  trackSerial    Boolean   @default(false)
  trackBatch     Boolean   @default(false)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  stockQuantities StockQuantity[]
  stockMoves      StockMove[]
  serialNumbers   SerialNumber[]
  batches         Batch[]
  boms            BillOfMaterial[]
  routings        Routing[]
  routingOperations BOMComponent[]
  workOrders      WorkOrder[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model StockQuantity {
  id           String    @id @default(cuid())
  quantity     Float     @default(0)
  reservedQty  Float     @default(0)
  availableQty Float     @default(0)
  productId    String
  product      Product   @relation(fields: [productId], references: [id])
  locationId   String
  location     StockLocation @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  @@unique([productId, locationId])
}

model StockMove {
  id             String        @id @default(cuid())
  type           StockMoveType
  reference      String?
  date           DateTime      @default(now())
  status         MoveStatus    @default(DRAFT)
  notes          String?
  productId      String
  product        Product       @relation(fields: [productId], references: [id])
  quantity       Float         @default(0)
  fromLocationId String?
  fromLocation   StockLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     StockLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  warehouseId    String?
  warehouse      Warehouse?    @relation(fields: [warehouseId], references: [id])
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  serialNumbers  SerialNumber[]
  batches        Batch[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum StockMoveType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
  RETURN
  SCRAP
}

enum MoveStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model SerialNumber {
  id             String       @id @default(cuid())
  number         String       @unique
  productId      String
  product        Product      @relation(fields: [productId], references: [id])
  status         SerialStatus @default(AVAILABLE)
  stockMoveId    String?
  stockMove      StockMove?   @relation(fields: [stockMoveId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum SerialStatus {
  AVAILABLE
  SOLD
  RESERVED
  DAMAGED
  LOST
}

model Batch {
  id               String    @id @default(cuid())
  number           String
  productId        String
  product          Product   @relation(fields: [productId], references: [id])
  quantity         Float     @default(0)
  expiryDate       DateTime?
  manufacturingDate DateTime?
  stockMoveId      String?
  stockMove        StockMove? @relation(fields: [stockMoveId], references: [id])
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BillOfMaterial {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  quantity       Float     @default(1)
  isActive       Boolean   @default(true)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  components     BOMComponent[]
  workOrders     WorkOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BOMComponent {
  id        String    @id @default(cuid())
  bomId     String
  bom       BillOfMaterial @relation(fields: [bomId], references: [id], onDelete: Cascade)
  productId String
  product   Product   @relation(fields: [productId], references: [id])
  quantity  Float     @default(1)
  unit      String    @default("Unit")
  scrapRate Float     @default(0)
  operation String?
  createdAt DateTime @default(now())
}

model WorkCenter {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  description    String?
  capacity       Float     @default(0)
  efficiency     Float     @default(100)
  costPerHour    Float     @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  operations     RoutingOperation[]
  workOrders     WorkOrder[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Routing {
  id             String    @id @default(cuid())
  name           String
  code           String    @unique
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  operations     RoutingOperation[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model RoutingOperation {
  id              String    @id @default(cuid())
  sequence        Int
  name            String
  description     String?
  durationMinutes Float     @default(0)
  setupMinutes    Float     @default(0)
  routingId       String
  routing         Routing   @relation(fields: [routingId], references: [id], onDelete: Cascade)
  workCenterId    String
  workCenter      WorkCenter @relation(fields: [workCenterId], references: [id])
  createdAt       DateTime @default(now())
}

model WorkOrder {
  id             String    @id @default(cuid())
  number         String    @unique
  type           WorkOrderType @default(MANUFACTURING)
  status         WorkOrderStatus @default(DRAFT)
  quantity       Float     @default(0)
  completedQty   Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  priority       Priority  @default(MEDIUM)
  notes          String?
  productId      String
  product        Product   @relation(fields: [productId], references: [id])
  bomId          String?
  bom            BillOfMaterial? @relation(fields: [bomId], references: [id])
  workCenterId   String?
  workCenter     WorkCenter? @relation(fields: [workCenterId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  qualityChecks  QualityCheck[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum WorkOrderType {
  MANUFACTURING
  REPAIR
  MAINTENANCE
}

enum WorkOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model QualityCheck {
  id             String    @id @default(cuid())
  type           QualityCheckType
  result         QualityResult @default(PENDING)
  notes          String?
  inspectedQty   Float     @default(0)
  passedQty      Float     @default(0)
  rejectedQty    Float     @default(0)
  workOrderId    String
  workOrder      WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum QualityCheckType {
  INCOMING
  IN_PROCESS
  FINAL
}

enum QualityResult {
  PENDING
  PASSED
  FAILED
  PARTIAL
}

model MaintenanceRequest {
  id             String    @id @default(cuid())
  number         String    @unique
  type           MaintenanceType
  status         MaintenanceStatus @default(REQUESTED)
  description    String
  assetName      String
  assetCode      String?
  priority       Priority  @default(MEDIUM)
  requestedDate  DateTime  @default(now())
  completedDate  DateTime?
  assignedToId   String?
  assignedTo     User?     @relation("AssignedMaintenance", fields: [assignedToId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum MaintenanceStatus {
  REQUESTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Employee {
  id             String    @id @default(cuid())
  employeeId     String    @unique
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  gender         String?
  maritalStatus  String?
  nationality    String?
  idNumber       String?
  taxPin         String?
  nssfNumber     String?
  nhifNumber     String?
  address        String?
  city           String?
  country        String?
  emergencyContact String?
  emergencyPhone  String?
  department     String?
  position       String?
  employmentType EmploymentType @default(FULL_TIME)
  status         EmployeeStatus @default(ACTIVE)
  hireDate       DateTime?
  terminationDate DateTime?
  salary         Float     @default(0)
  currency       String    @default("KES")
  bankName       String?
  bankAccount    String?
  notes          String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  attendances    Attendance[]
  leaveRequests  LeaveRequest[]
  leaveBalances  LeaveBalance[]
