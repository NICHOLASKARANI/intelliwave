generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(cuid())
  name                  String?
  email                 String              @unique
  emailVerified         DateTime?
  image                 String?
  password              String?
  phone                 String?
  avatar                String?
  role                  String              @default("USER")
  isActive              Boolean             @default(true)
  phoneVerified         Boolean             @default(false)
  otpCode               String?
  otpExpiry             DateTime?
  resetToken            String?
  resetExpiry           DateTime?
  lastLogin             DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  accounts              Account[]
  assignedActivities    Activity[]          @relation("AssignedActivities")
  auditLogs             AuditLog[]
  blogPosts             BlogPost[]
  comments              Comment[]
  assignedCustomers     Customer[]          @relation("AssignedCustomers")
  invoices              Invoice[]
  applications          JobApplication[]
  assignedLeads         Lead[]              @relation("AssignedLeads")
  approvedLeaves        LeaveRequest[]      @relation("ApprovedLeaves")
  messages              Message[]
  assignedOpportunities Opportunity[]       @relation("AssignedOpportunities")
  ownedOrganizations    Organization[]      @relation("OrganizationOwner")
  reviewerReviews       PerformanceReview[] @relation("ReviewerReviews")
  projects              Project[]
  sessions              Session[]
  subscription          Subscription?
  supportTickets        SupportTicket[]
  events                Event[]             @relation("EventToUser")
  memberOrganizations   Organization[]      @relation("OrganizationMembers")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionToken], map: "idx_session_token")
}

model Subscription {
  id             String             @id @default(cuid())
  plan           PlanType           @default(TRIAL)
  status         SubscriptionStatus @default(ACTIVE)
  amount         Float              @default(500)
  currency       String             @default("KES")
  startDate      DateTime           @default(now())
  endDate        DateTime?
  trialEndsAt    DateTime?
  nextBillingAt  DateTime?
  cancelledAt    DateTime?
  mpesaReceipt   String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  userId         String?            @unique
  organizationId String?            @unique
  organization   Organization?      @relation(fields: [organizationId], references: [id])
  user           User?              @relation(fields: [userId], references: [id])
}

model Organization {
  id                   String                @id @default(cuid())
  name                 String
  email                String?
  phone                String?
  address              String?
  logo                 String?
  currency             String                @default("KES")
  timezone             String                @default("Africa/Nairobi")
  isActive             Boolean               @default(true)
  trialEndsAt          DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  ownerId              String
  activities           Activity[]
  attendances          Attendance[]
  batches              Batch[]
  chartOfAccounts      ChartOfAccount[]
  customers            Customer[]
  customerInvoices     CustomerInvoice[]
  customerPayments     CustomerPayment[]
  employees            Employee[]
  employeeDocuments    EmployeeDocument[]
  fiscalYears          FiscalYear[]
  journalEntries       JournalEntry[]
  leads                Lead[]
  leaveBalances        LeaveBalance[]
  leaveRequests        LeaveRequest[]
  leaveTypes           LeaveType[]
  opportunities        Opportunity[]
  owner                User                  @relation("OrganizationOwner", fields: [ownerId], references: [id])
  payrollItems         PayrollItem[]
  payrollPeriods       PayrollPeriod[]
  performanceReviews   PerformanceReview[]
  products             Product[]
  quotations           Quotation[]
  routings             Routing[]
  salesOrders          SalesOrder[]
  serialNumbers        SerialNumber[]
  stockMoves           StockMove[]
  subscription         Subscription?
  trainings            Training[]
  trainingEnrollments  TrainingEnrollment[]
  warehouses           Warehouse[]
  members              User[]                @relation("OrganizationMembers")
  organizationSettings OrganizationSetting[]
  taxRates             TaxRate[]
  documentNumberings   DocumentNumbering[]
  emailTemplates       EmailTemplate[]
  integrations         Integration[]
  currencies           Currency[]
  roles                Role[]
}

model Project {
  id          String        @id @default(cuid())
  title       String
  description String
  status      String        @default("PENDING")
  budget      Float?
  currency    String        @default("KES")
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  clientId    String
  invoices    Invoice[]
  messages    Message[]
  milestones  Milestone[]
  client      User          @relation(fields: [clientId], references: [id])
  files       ProjectFile[]
}

model Milestone {
  id          String   @id @default(cuid())
  title       String
  description String?
  dueDate     DateTime
  completed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Invoice {
  id        String    @id @default(cuid())
  number    String    @unique
  amount    Float
  currency  String    @default("KES")
  status    String    @default("PENDING")
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime  @default(now())
  userId    String
  projectId String?
  project   Project?  @relation(fields: [projectId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model ProjectFile {
  id        String   @id @default(cuid())
  name      String
  url       String
  type      String
  size      Int
  createdAt DateTime @default(now())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model BlogPost {
  id            String    @id @default(cuid())
  title         String
  slug          String    @unique
  content       String
  excerpt       String?
  featuredImage String?
  category      String
  tags          String[]
  published     Boolean   @default(false)
  metaTitle     String?
  metaDesc      String?
  views         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  comments      Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
  postId    String
  userId    String
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SupportTicket {
  id          String    @id @default(cuid())
  subject     String
  description String
  priority    String    @default("MEDIUM")
  status      String    @default("OPEN")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  userId      String
  messages    Message[]
  user        User      @relation(fields: [userId], references: [id])
}

model Message {
  id        String         @id @default(cuid())
  content   String
  sender    String
  createdAt DateTime       @default(now())
  ticketId  String?
  projectId String?
  userId    String?
  project   Project?       @relation(fields: [projectId], references: [id])
  ticket    SupportTicket? @relation(fields: [ticketId], references: [id])
  user      User?          @relation(fields: [userId], references: [id])
}

model PortfolioItem {
  id           String   @id @default(cuid())
  title        String
  slug         String   @unique
  description  String
  category     String
  technologies String[]
  thumbnail    String?
  images       String[]
  results      Json?
  featured     Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Job {
  id           String           @id @default(cuid())
  title        String
  department   String
  location     String
  type         String
  description  String
  requirements String[]
  active       Boolean          @default(true)
  createdAt    DateTime         @default(now())
  applications JobApplication[]
}

model JobApplication {
  id          String   @id @default(cuid())
  resume      String
  coverLetter String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())
  jobId       String
  userId      String
  job         Job      @relation(fields: [jobId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Event {
  id              String   @id @default(cuid())
  title           String
  description     String
  type            String
  location        String?
  virtual         Boolean  @default(false)
  startDate       DateTime
  endDate         DateTime
  image           String?
  registrationUrl String?
  createdAt       DateTime @default(now())
  attendees       User[]   @relation("EventToUser")
}

model ChartOfAccount {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  type           AccountType
  parentId       String?
  isActive       Boolean          @default(true)
  isReconcilable Boolean          @default(false)
  description    String?
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  organization   Organization     @relation(fields: [organizationId], references: [id])
  parent         ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId], references: [id])
  children       ChartOfAccount[] @relation("AccountHierarchy")
  journalItems   JournalItem[]
}

model FiscalYear {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean        @default(false)
  organizationId String
  createdAt      DateTime       @default(now())
  periods        FiscalPeriod[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
}

model FiscalPeriod {
  id             String         @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean        @default(false)
  fiscalYearId   String
  createdAt      DateTime       @default(now())
  fiscalYear     FiscalYear     @relation(fields: [fiscalYearId], references: [id])
  journalEntries JournalEntry[]
}

model JournalEntry {
  id             String        @id @default(cuid())
  number         String        @unique
  date           DateTime
  reference      String?
  description    String
  status         EntryStatus   @default(DRAFT)
  amount         Float         @default(0)
  fiscalPeriodId String?
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  auditLogs      AuditLog[]
  fiscalPeriod   FiscalPeriod? @relation(fields: [fiscalPeriodId], references: [id], onDelete: Restrict)
  organization   Organization  @relation(fields: [organizationId], references: [id])
  items          JournalItem[]

  @@index([organizationId, createdAt], map: "idx_journal_org")
}

model JournalItem {
  id             String         @id @default(cuid())
  description    String?
  debit          Float          @default(0)
  credit         Float          @default(0)
  accountId      String
  journalEntryId String
  createdAt      DateTime       @default(now())
  account        ChartOfAccount @relation(fields: [accountId], references: [id])
  journalEntry   JournalEntry   @relation(fields: [journalEntryId], references: [id])
}

model AuditLog {
  id             String        @id @default(cuid())
  action         String
  entityType     String
  entityId       String
  changes        String?
  userId         String?
  journalEntryId String?
  createdAt      DateTime      @default(now())
  journalEntry   JournalEntry? @relation(fields: [journalEntryId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([userId, createdAt], map: "idx_auditlog_org")
}

model Customer {
  id             String            @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  address        String?
  city           String?
  country        String?
  taxId          String?
  website        String?
  notes          String?
  type           CustomerType      @default(INDIVIDUAL)
  status         CustomerStatus    @default(ACTIVE)
  source         String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  activities     Activity[]
  contacts       Contact[]
  assignedTo     User?             @relation("AssignedCustomers", fields: [assignedToId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  invoices       CustomerInvoice[]
  payments       CustomerPayment[]
  leads          Lead[]
  opportunities  Opportunity[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]

  @@index([organizationId], map: "idx_customer_org")
}

model Contact {
  id         String   @id @default(cuid())
  firstName  String
  lastName   String
  email      String?
  phone      String?
  position   String?
  department String?
  isPrimary  Boolean  @default(false)
  customerId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Lead {
  id             String       @id @default(cuid())
  name           String
  email          String?
  phone          String?
  company        String?
  source         String?
  status         LeadStatus   @default(NEW)
  priority       Priority     @default(MEDIUM)
  notes          String?
  score          Int          @default(0)
  assignedToId   String?
  customerId     String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  activities     Activity[]
  assignedTo     User?        @relation("AssignedLeads", fields: [assignedToId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "idx_lead_org")
}

model Opportunity {
  id                String       @id @default(cuid())
  name              String
  amount            Float        @default(0)
  stage             Stage        @default(QUALIFICATION)
  probability       Int          @default(0)
  expectedCloseDate DateTime?
  notes             String?
  customerId        String
  assignedToId      String?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  activities        Activity[]
  assignedTo        User?        @relation("AssignedOpportunities", fields: [assignedToId], references: [id])
  customer          Customer     @relation(fields: [customerId], references: [id])
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId], map: "idx_opportunity_org")
}

model Quotation {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  validUntil     DateTime?
  status         QuotationStatus @default(DRAFT)
  subtotal       Float           @default(0)
  taxAmount      Float           @default(0)
  total          Float           @default(0)
  notes          String?
  customerId     String
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  customer       Customer        @relation(fields: [customerId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
  items          QuotationItem[]
  salesOrders    SalesOrder[]
}

model QuotationItem {
  id          String    @id @default(cuid())
  description String
  quantity    Int       @default(1)
  unitPrice   Float     @default(0)
  total       Float     @default(0)
  quotationId String
  createdAt   DateTime  @default(now())
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

model SalesOrder {
  id             String            @id @default(cuid())
  number         String            @unique
  date           DateTime          @default(now())
  status         OrderStatus       @default(PENDING)
  subtotal       Float             @default(0)
  taxAmount      Float             @default(0)
  total          Float             @default(0)
  customerId     String
  quotationId    String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  invoices       CustomerInvoice[]
  customer       Customer          @relation(fields: [customerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  quotation      Quotation?        @relation(fields: [quotationId], references: [id])
  items          SalesOrderItem[]
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  description  String
  quantity     Int        @default(1)
  unitPrice    Float      @default(0)
  total        Float      @default(0)
  salesOrderId String
  createdAt    DateTime   @default(now())
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
}

model CustomerInvoice {
  id             String            @id @default(cuid())
  number         String            @unique
  date           DateTime          @default(now())
  dueDate        DateTime
  status         InvoiceStatus     @default(DRAFT)
  subtotal       Float             @default(0)
  taxAmount      Float             @default(0)
  total          Float             @default(0)
  customerId     String
  salesOrderId   String?
  organizationId String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  customer       Customer          @relation(fields: [customerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])
  salesOrder     SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  payments       CustomerPayment[]

  @@index([organizationId, createdAt], map: "idx_invoice_org")
}

model CustomerPayment {
  id             String          @id @default(cuid())
  number         String          @unique
  date           DateTime        @default(now())
  amount         Float
  method         PaymentMethod   @default(MPESA)
  reference      String?
  invoiceId      String
  customerId     String
  organizationId String
  createdAt      DateTime        @default(now())
  customer       Customer        @relation(fields: [customerId], references: [id])
  invoice        CustomerInvoice @relation(fields: [invoiceId], references: [id])
  organization   Organization    @relation(fields: [organizationId], references: [id])
}

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  subject        String
  description    String?
  dueDate        DateTime?
  completed      Boolean      @default(false)
  customerId     String?
  leadId         String?
  opportunityId  String?
  assignedToId   String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedTo     User?        @relation("AssignedActivities", fields: [assignedToId], references: [id])
  customer       Customer?    @relation(fields: [customerId], references: [id])
  lead           Lead?        @relation(fields: [leadId], references: [id])
  opportunity    Opportunity? @relation(fields: [opportunityId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Warehouse {
  id             String          @id @default(cuid())
  name           String
  code           String          @unique
  address        String?
  city           String?
  country        String?
  isActive       Boolean         @default(true)
  organizationId String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  locations      StockLocation[]
  stockMoves     StockMove[]
  organization   Organization    @relation(fields: [organizationId], references: [id])
}

model StockLocation {
  id              String          @id @default(cuid())
  name            String
  code            String
  warehouseId     String
  parentId        String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parent          StockLocation?  @relation("LocationHierarchy", fields: [parentId], references: [id])
  children        StockLocation[] @relation("LocationHierarchy")
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  fromMoves       StockMove[]     @relation("FromLocation")
  toMoves         StockMove[]     @relation("ToLocation")
  stockQuantities StockQuantity[]
}

model Product {
  id                String          @id @default(cuid())
  name              String
  sku               String          @unique
  barcode           String?
  description       String?
  category          String?
  unit              String          @default("Unit")
  costPrice         Float           @default(0)
  sellingPrice      Float           @default(0)
  minStock          Float           @default(0)
  maxStock          Float           @default(0)
  isActive          Boolean         @default(true)
  isTracked         Boolean         @default(true)
  trackSerial       Boolean         @default(false)
  trackBatch        Boolean         @default(false)
  organizationId    String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  routingOperations BOMComponent[]
  batches           Batch[]
  organization      Organization    @relation(fields: [organizationId], references: [id])
  routings          Routing[]
  serialNumbers     SerialNumber[]
  stockMoves        StockMove[]
  stockQuantities   StockQuantity[]

  @@index([organizationId], map: "idx_product_org")
}

model StockQuantity {
  id           String        @id @default(cuid())
  quantity     Float         @default(0)
  reservedQty  Float         @default(0)
  availableQty Float         @default(0)
  productId    String
  locationId   String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  location     StockLocation @relation(fields: [locationId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])

  @@unique([productId, locationId])
}

model StockMove {
  id             String         @id @default(cuid())
  type           StockMoveType
  reference      String?
  date           DateTime       @default(now())
  status         MoveStatus     @default(DRAFT)
  notes          String?
  productId      String
  quantity       Float          @default(0)
  fromLocationId String?
  toLocationId   String?
  warehouseId    String?
  organizationId String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  batches        Batch[]
  serialNumbers  SerialNumber[]
  fromLocation   StockLocation? @relation("FromLocation", fields: [fromLocationId], references: [id])
  organization   Organization   @relation(fields: [organizationId], references: [id])
  product        Product        @relation(fields: [productId], references: [id])
  toLocation     StockLocation? @relation("ToLocation", fields: [toLocationId], references: [id])
  warehouse      Warehouse?     @relation(fields: [warehouseId], references: [id])
}

model SerialNumber {
  id             String       @id @default(cuid())
  number         String       @unique
  productId      String
  status         SerialStatus @default(AVAILABLE)
  stockMoveId    String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])
  stockMove      StockMove?   @relation(fields: [stockMoveId], references: [id])
}

model Batch {
  id                String       @id @default(cuid())
  number            String
  productId         String
  quantity          Float        @default(0)
  expiryDate        DateTime?
  manufacturingDate DateTime?
  stockMoveId       String?
  organizationId    String
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  organization      Organization @relation(fields: [organizationId], references: [id])
  product           Product      @relation(fields: [productId], references: [id])
  stockMove         StockMove?   @relation(fields: [stockMoveId], references: [id])
}

model BillOfMaterial {
  id             String   @id @default(cuid())
  name           String
  code           String
  productId      String?
  quantity       Float    @default(1)
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model BOMComponent {
  id        String   @id @default(cuid())
  bomId     String
  productId String
  quantity  Float    @default(1)
  unit      String   @default("Unit")
  scrapRate Float    @default(0)
  operation String?
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
}

model WorkCenter {
  id             String   @id @default(cuid())
  name           String
  code           String
  description    String?
  capacity       Float    @default(0)
  efficiency     Float    @default(100)
  costPerHour    Float    @default(0)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Routing {
  id             String             @id @default(cuid())
  name           String
  code           String             @unique
  productId      String
  organizationId String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id])
  product        Product            @relation(fields: [productId], references: [id])
  operations     RoutingOperation[]
}

model RoutingOperation {
  id              String   @id @default(cuid())
  sequence        Int
  name            String
  description     String?
  durationMinutes Float    @default(0)
  setupMinutes    Float    @default(0)
  routingId       String
  workCenterId    String
  createdAt       DateTime @default(now())
  routing         Routing  @relation(fields: [routingId], references: [id], onDelete: Cascade)
}

model WorkOrder {
  id             String    @id @default(cuid())
  number         String
  type           String    @default("MANUFACTURING")
  status         String    @default("DRAFT")
  quantity       Float     @default(0)
  completedQty   Float     @default(0)
  startDate      DateTime?
  endDate        DateTime?
  priority       String    @default("MEDIUM")
  notes          String?
  productId      String?
  bomId          String?
  workCenterId   String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model QualityCheck {
  id             String   @id @default(cuid())
  type           String   @default("FINAL")
  result         String   @default("PENDING")
  notes          String?
  inspectedQty   Float    @default(0)
  passedQty      Float    @default(0)
  rejectedQty    Float    @default(0)
  workOrderId    String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model MaintenanceRequest {
  id             String    @id @default(cuid())
  number         String
  type           String    @default("CORRECTIVE")
  status         String    @default("REQUESTED")
  description    String
  assetName      String
  assetCode      String?
  priority       String    @default("MEDIUM")
  requestedDate  DateTime  @default(now())
  completedDate  DateTime?
  assignedToId   String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Employee {
  id                 String               @id @default(cuid())
  employeeId         String               @unique
  firstName          String
  lastName           String
  email              String?
  phone              String?
  dateOfBirth        DateTime?
  gender             String?
  maritalStatus      String?
  nationality        String?
  idNumber           String?
  taxPin             String?
  nssfNumber         String?
  nhifNumber         String?
  address            String?
  city               String?
  country            String?
  emergencyContact   String?
  emergencyPhone     String?
  department         String?
  position           String?
  employmentType     EmploymentType       @default(FULL_TIME)
  status             EmployeeStatus       @default(ACTIVE)
  hireDate           DateTime?
  terminationDate    DateTime?
  salary             Float                @default(0)
  currency           String               @default("KES")
  bankName           String?
  bankAccount        String?
  notes              String?
  organizationId     String
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  attendances        Attendance[]
  organization       Organization         @relation(fields: [organizationId], references: [id])
  documents          EmployeeDocument[]
  leaveBalances      LeaveBalance[]
  leaveRequests      LeaveRequest[]
  payrollItems       PayrollItem[]
  performanceReviews PerformanceReview[]
  trainings          TrainingEnrollment[]

  @@index([organizationId], map: "idx_employee_org")
}

model Attendance {
  id             String           @id @default(cuid())
  date           DateTime         @default(now())
  checkIn        DateTime?
  checkOut       DateTime?
  status         AttendanceStatus @default(PRESENT)
  notes          String?
  employeeId     String
  organizationId String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization     @relation(fields: [organizationId], references: [id])
}

model LeaveType {
  id               String         @id @default(cuid())
  name             String
  description      String?
  daysPerYear      Int            @default(21)
  isPaid           Boolean        @default(true)
  requiresApproval Boolean        @default(true)
  organizationId   String
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  leaveBalances    LeaveBalance[]
  leaveRequests    LeaveRequest[]
  organization     Organization   @relation(fields: [organizationId], references: [id])
}

model LeaveBalance {
  id             String       @id @default(cuid())
  totalDays      Float        @default(0)
  usedDays       Float        @default(0)
  remainingDays  Float        @default(0)
  year           Int
  employeeId     String
  leaveTypeId    String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model LeaveRequest {
  id             String       @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveStatus  @default(PENDING)
  employeeId     String
  leaveTypeId    String
  approvedById   String?
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  approvedBy     User?        @relation("ApprovedLeaves", fields: [approvedById], references: [id])
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType      LeaveType    @relation(fields: [leaveTypeId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model PayrollPeriod {
  id             String        @id @default(cuid())
  name           String
  startDate      DateTime
  endDate        DateTime
  paymentDate    DateTime
  status         PayrollStatus @default(DRAFT)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  items          PayrollItem[]
  organization   Organization  @relation(fields: [organizationId], references: [id])
}

model PayrollItem {
  id              String        @id @default(cuid())
  basicSalary     Float         @default(0)
  allowances      Float         @default(0)
  deductions      Float         @default(0)
  netSalary       Float         @default(0)
  employeeId      String
  payrollPeriodId String
  organizationId  String
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  employee        Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization    Organization  @relation(fields: [organizationId], references: [id])
  payrollPeriod   PayrollPeriod @relation(fields: [payrollPeriodId], references: [id])
}

model PerformanceReview {
  id             String       @id @default(cuid())
  reviewDate     DateTime     @default(now())
  rating         Int          @default(0)
  strengths      String?
  improvements   String?
  goals          String?
  employeeId     String
  reviewerId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  reviewer       User         @relation("ReviewerReviews", fields: [reviewerId], references: [id])
}

model Training {
  id             String               @id @default(cuid())
  title          String
  description    String?
  type           String
  startDate      DateTime
  endDate        DateTime
  provider       String?
  cost           Float                @default(0)
  organizationId String
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  organization   Organization         @relation(fields: [organizationId], references: [id])
  enrollments    TrainingEnrollment[]
}

model TrainingEnrollment {
  id             String       @id @default(cuid())
  status         String       @default("ENROLLED")
  completionDate DateTime?
  notes          String?
  employeeId     String
  trainingId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
  training       Training     @relation(fields: [trainingId], references: [id])
}

model EmployeeDocument {
  id             String       @id @default(cuid())
  name           String
  type           String
  url            String
  employeeId     String
  organizationId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  employee       Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id])
}

model UserProfile {
  id        Int       @id @default(autoincrement())
  userid    String    @unique
  fullname  String
  email     String    @unique
  phone     String?
  avatar    String?
  role      String?   @default("User")
  status    String?   @default("Active")
  createdat DateTime? @default(now()) @db.Timestamp(6)
  updatedat DateTime? @default(now()) @db.Timestamp(6)
}

model OrganizationSetting {
  id             Int          @id @default(autoincrement())
  organizationId String
  companyname    String       @default("WaveCore ERP")
  email          String?
  phone          String?
  address        String?
  website        String?
  timezone       String?      @default("Africa/Nairobi")
  language       String?      @default("English")
  currency       String?      @default("KES")
  dateformat     String?      @default("DD/MM/YYYY")
  currencysymbol String?      @default("KSh")
  numberformat   String?      @default("1,234.56")
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model TaxRate {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  rate           Decimal      @db.Decimal(5, 2)
  type           String       @default("VAT")
  active         Boolean?     @default(true)
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model DocumentNumbering {
  id             Int          @id @default(autoincrement())
  organizationId String
  documenttype   String
  prefix         String
  nextnumber     Int?         @default(1)
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, documenttype])
  @@index([organizationId])
}

model EmailTemplate {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  subject        String
  body           String?
  active         Boolean?     @default(true)
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model Integration {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  type           String
  apikey         String?
  status         String?      @default("Disconnected")
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

model ApiKey {
  id             String    @id
  organizationId String
  name           String
  key            String    @unique(map: "idx_apikey_key")
  prefix         String
  lastUsedAt     DateTime?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())

  @@index([organizationId, isActive], map: "idx_apikey_org")
}

model BankAccount {
  id             String   @id
  name           String
  accountNumber  String
  bankName       String
  currency       String   @default("KES")
  openingBalance Float    @default(0)
  currentBalance Float    @default(0)
  organizationId String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([organizationId, isActive], map: "idx_bankaccount_org")
}

model BankReconciliation {
  id               String    @id
  bankAccountId    String
  statementDate    DateTime
  statementBalance Float
  closingBalance   Float     @default(0)
  status           String    @default("IN_PROGRESS")
  organizationId   String
  createdAt        DateTime  @default(now())
  completedAt      DateTime?

  @@index([organizationId, status], map: "idx_bankrecon_org")
}

model BankTransaction {
  id                   String   @id
  bankAccountId        String
  date                 DateTime
  description          String
  reference            String?
  amount               Float
  type                 String   @default("CREDIT")
  matched              Boolean  @default(false)
  matchedTransactionId String?
  organizationId       String
  createdAt            DateTime @default(now())

  @@index([organizationId, matched, date], map: "idx_banktxn_org")
}

model Budget {
  id             String    @id
  name           String
  fiscalYear     Int
  period         String    @default("ANNUAL")
  amount         Float?    @default(0)
  organizationId String
  createdAt      DateTime? @default(now())
  updatedAt      DateTime? @default(now())
}

model Currency {
  id             Int          @id @default(autoincrement())
  organizationId String
  code           String
  name           String
  rate           Decimal      @db.Decimal(10, 4)
  isdefault      Boolean?     @default(false)
  updatedat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
}

model Notification {
  id             String   @id
  userId         String?
  organizationId String?
  type           String   @default("SYSTEM")
  title          String
  content        String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt], map: "idx_notification_org")
  @@index([userId, isRead, createdAt], map: "idx_notification_user")
}

model PipelineStage {
  id             String   @id
  name           String
  order          Int      @default(0)
  color          String   @default("#6366f1")
  organizationId String
  createdAt      DateTime @default(now())

  @@index([organizationId, order], map: "idx_pipelinestage_org")
}

model PurchaseOrder {
  id             String   @id @default(cuid())
  number         String?
  date           DateTime @default(now())
  status         String   @default("DRAFT")
  subtotal       Float    @default(0)
  taxAmount      Float    @default(0)
  total          Float    @default(0)
  amount         Float    @default(0)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  supplierName   String?
  productId      String?
  productName    String?
  notes          String?
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  items PurchaseOrderItem[]

  @@index([organizationId])
  @@index([organizationId, number], map: "idx_po_number")
  @@index([organizationId, createdAt], map: "idx_po_org")
  @@index([supplierId])
}

model PurchaseOrderItem {
  id              String   @id @default(cuid())
  description     String
  quantity        Int      @default(1)
  unitPrice       Float    @default(0)
  total           Float    @default(0)
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([purchaseOrderId])
}

model Role {
  id             Int          @id @default(autoincrement())
  organizationId String
  name           String
  description    String?
  permissions    String[]     @default([])
  createdat      DateTime?    @default(now()) @db.Timestamp(6)
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, name])
  @@index([organizationId])
}

model Webhook {
  id             String   @id
  organizationId String
  name           String
  url            String
  secret         String
  events         String[] @default(dbgenerated("'{*}'::text[]"))
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime

  @@index([organizationId, isActive], map: "idx_webhook_org")
}

enum PlanType {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum EntryStatus {
  DRAFT
  POSTED
  REVERSED
  CANCELLED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  GOVERNMENT
  NGO
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  LEAD
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Stage {
  QUALIFICATION
  NEEDS_ANALYSIS
  PROPOSAL
  NEGOTIATION
  CLOSED_WON
  CLOSED_LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  CANCELLED
}

enum PaymentMethod {
  MPESA
  BANK_TRANSFER
  CASH
  CHEQUE
  CREDIT_CARD
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  NOTE
  WHATSAPP
}

enum StockMoveType {
  RECEIPT
  DELIVERY
  TRANSFER
  ADJUSTMENT
  RETURN
  SCRAP
}

enum MoveStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum SerialStatus {
  AVAILABLE
  SOLD
  RESERVED
  DAMAGED
  LOST
}

enum WorkOrderType {
  MANUFACTURING
  REPAIR
  MAINTENANCE
}

enum WorkOrderStatus {
  DRAFT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum QualityCheckType {
  INCOMING
  IN_PROCESS
  FINAL
}

enum QualityResult {
  PENDING
  PASSED
  FAILED
  PARTIAL
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  EMERGENCY
}

enum MaintenanceStatus {
  REQUESTED
  APPROVED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  TERMINATED
  ON_LEAVE
  SUSPENDED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  EXCUSED
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum PayrollStatus {
  DRAFT
  PROCESSED
  APPROVED
  PAID
}


// ============================================================
// PROCUREMENT MODULE — Source-to-Pay (S2P) / Procure-to-Pay (P2P)
// Added: P0 schema expansion — 49 models
// Every model is tenant-isolated via organizationId
// ============================================================

// ---------- SUPPLIER ----------
model Supplier {
  id                 String   @id @default(cuid())
  organizationId     String
  code               String?
  name               String?
  email              String?
  phone              String?
  legalName          String?
  tradingName        String?
  registrationNumber String?
  taxPin             String?
  vatStatus          String?  @default("NOT_REGISTERED")
  country            String?  @default("KE")
  county             String?
  address            String?
  city               String?
  postalCode         String?
  website            String?
  primaryEmail       String?
  primaryPhone       String?
  currency           String   @default("KES")
  paymentTerms       Int      @default(30)
  creditLimit        Decimal? @default(0) @db.Decimal(18, 2)
  status             String   @default("ACTIVE")
  isPreferred        Boolean  @default(false)
  isBlacklisted      Boolean  @default(false)
  blacklistReason    String?
  category           String?
  notes              String?
  riskScore          Int?     @default(0)
  riskLevel          String?  @default("LOW")
  rating             Int?     @default(0)
  onboardedAt        DateTime?
  createdBy          String?
  updatedBy          String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  contacts     SupplierContact[]
  bankAccounts SupplierBankAccount[]
  documents    SupplierDocument[]
  qualifications SupplierQualification[]
  scorecards   SupplierScorecard[]
  risks        SupplierRisk[]
  purchaseOrders PurchaseOrder[]
  rfqInvites   RFQSupplier[]
  quotations   SupplierQuotation[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, legalName])
  @@index([organizationId, taxPin])
}

model SupplierContact {
  id           String   @id @default(cuid())
  organizationId String
  supplierId   String
  name         String
  role         String?
  email        String?
  phone        String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
}

model SupplierBankAccount {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  bankName       String
  accountName    String
  accountNumber  String
  branchCode     String?
  swiftCode      String?
  currency       String   @default("KES")
  isPrimary      Boolean  @default(false)
  isVerified     Boolean  @default(false)
  verifiedAt     DateTime?
  verifiedBy     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
}

model SupplierDocument {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  documentType   String
  name           String
  fileUrl        String
  fileSize       Int?
  mimeType       String?
  issueDate      DateTime?
  expiryDate     DateTime?
  status         String   @default("PENDING")
  verifiedAt     DateTime?
  verifiedBy     String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@index([expiryDate])
}

model SupplierQualification {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  qualificationType String
  status         String   @default("PENDING")
  score          Int?     @default(0)
  validFrom      DateTime?
  validUntil     DateTime?
  assessedBy     String?
  assessedAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
}

model SupplierScorecard {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  periodStart    DateTime
  periodEnd      DateTime
  deliveryScore  Int      @default(0)
  qualityScore   Int      @default(0)
  priceScore     Int      @default(0)
  responsivenessScore Int @default(0)
  complianceScore Int     @default(0)
  overallScore   Int      @default(0)
  onTimeDeliveryPct Decimal? @db.Decimal(5, 2)
  fillRatePct       Decimal? @db.Decimal(5, 2)
  defectRatePct     Decimal? @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId, periodStart])
}

model SupplierRisk {
  id             String   @id @default(cuid())
  organizationId String
  supplierId     String
  riskType       String
  severity       String   @default("LOW")
  title          String
  description    String?
  detectedAt     DateTime @default(now())
  detectedBy     String?  @default("SYSTEM")
  status         String   @default("OPEN")
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([supplierId])
  @@index([organizationId, status])
}

// ---------- REQUISITION ----------
model PurchaseRequisition {
  id             String   @id @default(cuid())
  organizationId String
  requisitionNumber String?
  title          String?
  description    String?
  category       String   @default("GENERAL")
  priority       String   @default("NORMAL")
  type           String   @default("STANDARD")
  requestedBy    String?
  requestedByName String?
  departmentId   String?
  projectId      String?
  costCenter     String?
  location       String?
  currency       String   @default("KES")
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  budgetId       String?
  neededBy       DateTime?
  status         String   @default("DRAFT")
  currentApprovalStep Int @default(0)
  totalApprovalSteps  Int @default(0)
  submittedAt    DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  rejectionReason String?
  convertedToPOId String?
  isEmergency    Boolean  @default(false)
  isRecurring    Boolean  @default(false)
  recurrenceRule String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lines     PurchaseRequisitionLine[]
  approvals PurchaseRequisitionApproval[]
  @@index([organizationId, requisitionNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, requestedBy])
  @@index([organizationId, departmentId])
}

model PurchaseRequisitionLine {
  id             String   @id @default(cuid())
  organizationId String
  requisitionId  String
  lineNumber     Int
  description    String
  productId      String?
  category       String?
  quantity       Decimal  @db.Decimal(18, 3)
  unitOfMeasure  String   @default("UNIT")
  unitPrice      Decimal  @default(0) @db.Decimal(18, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 2)
  specifications String?
  preferredSupplierId String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requisitionId])
}

model PurchaseRequisitionApproval {
  id             String   @id @default(cuid())
  organizationId String
  requisitionId  String
  stepNumber     Int
  approverId     String
  approverRole   String?
  status         String   @default("PENDING")
  decision       String?
  comment        String?
  decidedAt      DateTime?
  dueAt          DateTime?
  slaHours       Int      @default(48)
  delegatedTo    String?
  delegatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  requisition   PurchaseRequisition @relation(fields: [requisitionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([requisitionId, stepNumber])
  @@index([organizationId, approverId, status])
}

// ---------- RFQ / RFx ----------
model RFQ {
  id             String   @id @default(cuid())
  organizationId String
  rfqNumber      String?
  title          String
  description    String?
  type           String   @default("RFQ") // RFQ | RFP | RFI
  category       String?
  status         String   @default("DRAFT")
  requisitionId  String?
  currency       String   @default("KES")
  issueDate      DateTime?
  closingDate    DateTime?
  deliveryDate   DateTime?
  deliveryLocation String?
  paymentTerms   String?
  evaluationCriteria Json?
  createdBy      String?
  createdByName  String?
  publishedAt    DateTime?
  awardedAt      DateTime?
  awardedBidId   String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines    RFQLine[]
  suppliers RFQSupplier[]
  quotations SupplierQuotation[]
  @@index([organizationId, rfqNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model RFQLine {
  id             String   @id @default(cuid())
  organizationId String
  rfqId          String
  lineNumber     Int
  description    String
  productId      String?
  quantity       Decimal  @db.Decimal(18, 3)
  unitOfMeasure  String   @default("UNIT")
  specifications String?
  targetPrice    Decimal? @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq RFQ @relation(fields: [rfqId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([rfqId])
}

model RFQSupplier {
  id             String   @id @default(cuid())
  organizationId String
  rfqId          String
  supplierId     String
  invitedAt      DateTime @default(now())
  invitedBy      String?
  status         String   @default("INVITED") // INVITED | VIEWED | QUOTED | DECLINED
  respondedAt    DateTime?
  declineReason  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  rfq      RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@unique([rfqId, supplierId])
  @@index([organizationId])
  @@index([supplierId])
}

// ---------- QUOTATION / BID ----------
model Bid {
  id             String   @id @default(cuid())
  organizationId String
  bidNumber      String
  rfqId          String?
  supplierId     String
  version        Int      @default(1)
  status         String   @default("DRAFT")
  currency       String   @default("KES")
  subtotal       Decimal  @default(0) @db.Decimal(18, 2)
  taxAmount      Decimal  @default(0) @db.Decimal(18, 2)
  discount       Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal  @default(0) @db.Decimal(18, 2)
  deliveryDays   Int?
  warrantyMonths Int?
  validityDays   Int?
  paymentTerms   String?
  technicalScore Int?
  commercialScore Int?
  overallScore   Int?
  evaluationNotes String?
  submittedAt    DateTime?
  evaluatedAt    DateTime?
  evaluatedBy    String?
  isAwarded      Boolean  @default(false)
  awardedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines BidLine[]

  @@index([organizationId])
  @@index([organizationId, rfqId])
  @@index([organizationId, supplierId])
}

model BidLine {
  id             String   @id @default(cuid())
  organizationId String
  bidId          String
  rfqLineId      String?
  lineNumber     Int
  description    String
  quantity       Decimal  @db.Decimal(18, 3)
  unitPrice      Decimal  @db.Decimal(18, 2)
  taxRate        Decimal  @default(0) @db.Decimal(5, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 2)
  deliveryDays   Int?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bid Bid @relation(fields: [bidId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([bidId])
}

model BidEvaluation {
  id             String   @id @default(cuid())
  organizationId String
  bidId          String
  criterion      String
  weight         Decimal  @db.Decimal(5, 2)
  score          Decimal  @db.Decimal(5, 2)
  weightedScore  Decimal  @db.Decimal(8, 2)
  comment        String?
  evaluatedBy    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([bidId])
}

model BidAward {
  id             String   @id @default(cuid())
  organizationId String
  rfqId          String?
  bidId          String
  supplierId     String
  awardedBy      String
  awardedAt      DateTime @default(now())
  justification  String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([bidId])
}

// ---------- AUCTION ----------
model Auction {
  id             String   @id @default(cuid())
  organizationId String
  auctionNumber  String
  title          String
  description    String?
  status         String   @default("DRAFT")
  currency       String   @default("KES")
  startingPrice  Decimal  @db.Decimal(18, 2)
  minDecrement   Decimal  @db.Decimal(18, 2)
  currentPrice   Decimal? @db.Decimal(18, 2)
  reservePrice   Decimal? @db.Decimal(18, 2)
  startAt        DateTime?
  endAt          DateTime?
  isAnonymous    Boolean  @default(false)
  isSealed       Boolean  @default(false)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  bids AuctionBid[]

  @@unique([organizationId, auctionNumber])
  @@index([organizationId])
  @@index([organizationId, status])
}

model AuctionBid {
  id             String   @id @default(cuid())
  organizationId String
  auctionId      String
  supplierId     String
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("KES")
  isWinning      Boolean  @default(false)
  placedAt       DateTime @default(now())

  auction Auction @relation(fields: [auctionId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([auctionId])
  @@index([auctionId, amount])
}

// ---------- CONTRACT ----------
model Contract {
  id             String   @id @default(cuid())
  organizationId String
  contractNumber String
  title          String
  description    String?
  type           String   @default("SUPPLY")
  status         String   @default("DRAFT")
  supplierId     String
  rfqId          String?
  purchaseOrderId String?
  currency       String   @default("KES")
  value          Decimal  @default(0) @db.Decimal(18, 2)
  startDate      DateTime?
  endDate        DateTime?
  signedDate     DateTime?
  signedBy       String?
  signedBySupplier String?
  autoRenew      Boolean  @default(false)
  renewalNoticeDays Int   @default(30)
  documentUrl    String?
  terms          String?
  slaTerms       String?
  penalties      String?
  notes          String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines ContractLine[]
  milestones ContractMilestone[]

  @@unique([organizationId, contractNumber])
  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, supplierId])
  @@index([endDate])
}

model ContractLine {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  lineNumber     Int
  description    String
  productId      String?
  quantity       Decimal? @db.Decimal(18, 3)
  unitPrice      Decimal? @db.Decimal(18, 2)
  unitOfMeasure  String?  @default("UNIT")
  discountPct    Decimal? @db.Decimal(5, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contractId])
}

model ContractMilestone {
  id             String   @id @default(cuid())
  organizationId String
  contractId     String
  title          String
  description    String?
  dueDate        DateTime
  completedAt    DateTime?
  status         String   @default("PENDING")
  amount         Decimal? @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([contractId])
}

// ---------- GOODS RECEIPT ----------
model GoodsReceipt {
  id             String   @id @default(cuid())
  organizationId String
  grnNumber      String?
  purchaseOrderId String?
  receivedBy     String?
  receivedByName String?
  status         String   @default("DRAFT")
  receivedAt     DateTime?
  deliveryNoteNumber String?
  deliveryNoteUrl String?
  vehicleNumber  String?
  driverName     String?
  warehouseId    String?
  locationId     String?
  currency       String   @default("KES")
  totalReceived  Decimal  @default(0) @db.Decimal(18, 2)
  quantity       Float?
  hasVariance    Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  lines GoodsReceiptLine[]
  inspections QualityInspection[]
  @@index([organizationId, grnNumber])
  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
  @@index([organizationId, status])
}

model GoodsReceiptLine {
  id             String   @id @default(cuid())
  organizationId String
  goodsReceiptId String
  poLineId       String?
  lineNumber     Int
  description    String
  productId      String?
  orderedQty     Decimal  @db.Decimal(18, 3)
  receivedQty    Decimal  @db.Decimal(18, 3)
  rejectedQty    Decimal  @default(0) @db.Decimal(18, 3)
  damagedQty     Decimal  @default(0) @db.Decimal(18, 3)
  unitPrice      Decimal  @db.Decimal(18, 2)
  lineTotal      Decimal  @default(0) @db.Decimal(18, 2)
  serialNumbers  String?
  batchNumber    String?
  lotNumber      String?
  expiryDate     DateTime?
  condition      String   @default("GOOD")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([goodsReceiptId])
}

model QualityInspection {
  id             String   @id @default(cuid())
  organizationId String
  goodsReceiptId String?
  purchaseOrderId String?
  inspectorId    String?
  inspectorName  String?
  status         String   @default("PENDING")
  inspectedAt    DateTime?
  sampleSize     Int?
  passedQty      Decimal? @db.Decimal(18, 3)
  failedQty      Decimal? @db.Decimal(18, 3)
  findings       String?
  correctiveAction String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  goodsReceipt GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([organizationId, status])
}

// ---------- THREE-WAY MATCH / INVOICE MATCH ----------
model ThreeWayMatch {
  id             String   @id @default(cuid())
  organizationId String
  purchaseOrderId String
  goodsReceiptId String?
  supplierInvoiceId String?
  invoiceNumber  String?
  invoiceDate    DateTime?
  invoiceAmount  Decimal  @db.Decimal(18, 2)
  poAmount       Decimal  @db.Decimal(18, 2)
  receivedAmount Decimal  @db.Decimal(18, 2)
  varianceAmount Decimal  @default(0) @db.Decimal(18, 2)
  variancePct    Decimal  @default(0) @db.Decimal(8, 2)
  status         String   @default("PENDING")
  matchType      String   @default("THREE_WAY")
  matchedAt      DateTime?
  matchedBy      String?
  exceptionId    String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, purchaseOrderId])
}

model ProcurementException {
  id             String   @id @default(cuid())
  organizationId String
  exceptionType  String
  severity       String   @default("MEDIUM")
  referenceType  String?
  referenceId    String?
  title          String
  description    String?
  status         String   @default("OPEN")
  detectedAt     DateTime @default(now())
  detectedBy     String?  @default("SYSTEM")
  resolvedAt     DateTime?
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, exceptionType])
}

// ---------- LANDED COST ----------
model LandedCost {
  id             String   @id @default(cuid())
  organizationId String
  purchaseOrderId String
  currency       String   @default("KES")
  purchasePrice  Decimal  @default(0) @db.Decimal(18, 2)
  freight        Decimal  @default(0) @db.Decimal(18, 2)
  insurance      Decimal  @default(0) @db.Decimal(18, 2)
  customsDuty    Decimal  @default(0) @db.Decimal(18, 2)
  taxes          Decimal  @default(0) @db.Decimal(18, 2)
  handling       Decimal  @default(0) @db.Decimal(18, 2)
  otherCharges   Decimal  @default(0) @db.Decimal(18, 2)
  totalLandedCost Decimal @default(0) @db.Decimal(18, 2)
  incoterms      String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, purchaseOrderId])
}

// ---------- SPEND / BUDGET ----------
model SpendCategory {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String?
  parentId       String?
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, parentId])
}

model SpendAnalysis {
  id             String   @id @default(cuid())
  organizationId String
  periodStart    DateTime
  periodEnd      DateTime
  categoryId     String?
  supplierId     String?
  departmentId   String?
  projectId      String?
  costCenter     String?
  currency       String   @default("KES")
  amount         Decimal  @default(0) @db.Decimal(18, 2)
  isContracted   Boolean  @default(false)
  isMaverick     Boolean  @default(false)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, periodStart])
  @@index([organizationId, supplierId])
}

model ProcurementBudget {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  fiscalYear     String?
  departmentId   String?
  categoryId     String?
  costCenter     String?
  currency       String   @default("KES")
  budgetAmount   Decimal  @default(0) @db.Decimal(18, 2)
  committedAmount Decimal @default(0) @db.Decimal(18, 2)
  actualAmount   Decimal  @default(0) @db.Decimal(18, 2)
  availableAmount Decimal @default(0) @db.Decimal(18, 2)
  periodStart    DateTime?
  periodEnd      DateTime?
  status         String   @default("ACTIVE")
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, fiscalYear])
}

model ProcurementCommitment {
  id             String   @id @default(cuid())
  organizationId String
  budgetId       String?
  purchaseOrderId String?
  requisitionId  String?
  amount         Decimal  @db.Decimal(18, 2)
  currency       String   @default("KES")
  status         String   @default("ACTIVE")
  committedAt    DateTime @default(now())
  releasedAt     DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, budgetId])
}

// ---------- WORKFLOW / APPROVAL RULES ----------
model ProcurementWorkflow {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  triggerEvent   String
  conditions     Json?
  actions        Json?
  isActive       Boolean  @default(true)
  priority       Int      @default(0)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, triggerEvent])
}

model ProcurementApprovalRule {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  appliesTo      String   @default("REQUISITION")
  minAmount      Decimal  @default(0) @db.Decimal(18, 2)
  maxAmount      Decimal? @db.Decimal(18, 2)
  category       String?
  departmentId   String?
  location       String?
  currency       String   @default("KES")
  approverRole   String
  approverUserId String?
  stepNumber     Int      @default(1)
  isRequired     Boolean  @default(true)
  slaHours       Int      @default(48)
  isActive       Boolean  @default(true)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, appliesTo])
  @@index([organizationId, minAmount, maxAmount])
}

model ProcurementApproval {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  stepNumber     Int
  approverId     String
  approverRole   String?
  status         String   @default("PENDING")
  decision       String?
  comment        String?
  decidedAt      DateTime?
  dueAt          DateTime?
  delegatedTo    String?
  delegatedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, approverId, status])
}

// ---------- EVENT / AUDIT ----------
model ProcurementEvent {
  id             String   @id @default(cuid())
  organizationId String
  eventType      String
  entityType     String?
  entityId       String?
  actorId        String?
  actorName      String?
  summary        String?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, eventType])
  @@index([organizationId, createdAt])
}

model ProcurementAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  entityType     String
  entityId       String
  action         String
  fieldName      String?
  oldValue       String?
  newValue       String?
  actorId        String?
  actorName      String?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  @@index([organizationId])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
}

// ============================================================
// SupplierQuotation — bridges live /api/wavecore/quotes route
// (DB table: "SupplierQuote") into the ORM
// ============================================================
model SupplierQuotation {
  id             String    @id @default(cuid())
  organizationId String
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  rfqId          String?
  rfq            RFQ?      @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  supplierName   String?
  number         String?
  amount         Float     @default(0)
  currency       String    @default("KES")
  status         String    @default("RECEIVED")
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
  @@index([organizationId, supplierId])
  @@index([organizationId, status])
  @@map("SupplierQuote")
}